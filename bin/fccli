#!/usr/bin/env python3
"""Talk to a running FreeCAD's command line.

Nothing here imports FreeCAD. The client speaks a unix socket and the
standard library, so it runs from any terminal, any virtualenv, and on a
machine where FreeCAD is not on PATH.

    fccli exec 'box 0,0,0 40 30 20'
    fccli check 'cylinder 12 40'
    fccli history
    echo 'circle 0,0,0 20' | fccli
    fccli state

Exit codes separate "wrong" from "not now":

    0   done
    1   the command was rejected -- a fault, reason on stderr
    2   usage
    3   no running instance, or it went away
    4   several instances, pass --pid
    75  busy -- a dialog is open or someone holds the floor. Informational,
        nothing on stderr, and EX_TEMPFAIL by convention so a script that
        checks `if ! fccli exec` does not read it as a broken command.
"""

import argparse
import errno
import glob
import json
import os
import select
import shutil
import socket
import subprocess
import sys
import tempfile
import time

EX_OK, EX_REJECTED, EX_USAGE, EX_NOINSTANCE, EX_AMBIGUOUS = 0, 1, 2, 3, 4
EX_TEMPFAIL = 75

PROTOCOL = 1


def socket_dir():
    root = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return os.path.join(root, "fccli")


def instances():
    """Live sockets, newest first. A stale one is removed as it is found."""
    found = []
    for path in sorted(glob.glob(os.path.join(socket_dir(), "*.sock"))):
        pid = os.path.basename(path)[:-5]
        if not pid.isdigit() or not _alive(int(pid)):
            _remove_stale(path)
            continue
        found.append((int(pid), path))
    return sorted(found, reverse=True)


def _alive(pid):
    try:
        os.kill(pid, 0)
    except OSError as exc:
        return exc.errno == errno.EPERM
    return True


def _remove_stale(path):
    try:
        os.remove(path)
        print(f"fccli: removed stale socket {path}", file=sys.stderr)
    except OSError:
        pass


class Client:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(30)
        self.sock.connect(path)
        self.buffer = b""
        self.hello = self.read()

    def send(self, **request):
        self.sock.sendall((json.dumps(request) + "\n").encode("utf-8"))

    def read(self):
        while b"\n" not in self.buffer:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("the FreeCAD session closed")
            self.buffer += chunk
        line, _, self.buffer = self.buffer.partition(b"\n")
        return json.loads(line.decode("utf-8"))

    def ask(self, **request):
        self.send(**request)
        return self.read()

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


# ------------------------------------------------------------------ output

ROLE_ANSI = {
    "head": "\033[36m", "value": "\033[32m", "ok": "\033[36m",
    "warn": "\033[33m", "bad": "\033[31m", "quiet": "\033[90m",
    "error": "\033[31m", "result": "\033[36m", "prompt": "\033[33m",
    "echo": "\033[0m", "info": "\033[90m",
}
RESET = "\033[0m"


def paint(text, role, stream):
    if not stream.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"{ROLE_ANSI.get(role, '')}{text}{RESET}"


def documents_of(payload):
    """Document rows, from a server of any version.

    A FreeCAD started before an upgrade is still running the module it
    loaded, so a newer client will meet an older server. Older ones reported
    documents as bare names.
    """
    rows = []
    for doc in payload.get("documents") or []:
        if isinstance(doc, str):
            rows.append({"name": doc, "label": doc, "file": None,
                         "objects": None, "dirty": None, "active": None})
        elif isinstance(doc, dict):
            rows.append(doc)
    return rows


def show_document(doc, indent="  "):
    mark = "*" if doc.get("active") else " "
    count = doc.get("objects")
    count = f"{count:>4} objects" if isinstance(count, int) else " " * 12
    dirty = " [unsaved]" if doc.get("dirty") else ""
    where = doc.get("file") or "(never saved)"
    print(f"{indent}{mark} {doc.get('label') or doc.get('name'):<20}"
          f"{count}  {where}{dirty}")


def warn_protocol(client):
    theirs = client.hello.get("protocol")
    if theirs is not None and theirs != PROTOCOL:
        print(f"fccli: this session speaks protocol {theirs}, "
              f"the client speaks {PROTOCOL}. Restart FreeCAD to match.",
              file=sys.stderr)


def render(reply, args):
    """Print one submit reply, and return the exit code it implies."""
    if args.json:
        print(json.dumps(reply))
        return EX_OK if reply.get("ok", True) else EX_REJECTED

    if reply.get("kind") == "busy":
        detail = reply.get("detail") or reply.get("holder") or reply["reason"]
        print(f"not now: {detail}. The command was not run.")
        return EX_TEMPFAIL

    # A one-shot answers; it does not narrate. The live echo and the
    # prompts a getter raises are progress for someone watching a session,
    # not output for someone who asked one question. -v shows them.
    ANSWER = ("result", "info", "error")
    for msg in reply.get("messages", []):
        kind = msg["kind"]
        if not msg["text"]:
            continue
        if kind not in ANSWER and not args.verbose:
            continue
        role = msg.get("role", kind)
        # stdout carries the answer; anything else goes to stderr so it
        # never lands in a redirect.
        stream = sys.stdout if kind in ("result", "info") else sys.stderr
        prefix = {"error": "error: ", "result": "= "}.get(kind, "")
        print(paint(prefix + msg["text"], role, stream), file=stream)

    if reply.get("engine") != "idle" and reply.get("prompt"):
        options = reply.get("options") or []
        tail = f" [{'/'.join(options)}]" if options else ""
        print(paint(f"incomplete: still wants {reply['prompt']}{tail}",
                    "warn", sys.stderr), file=sys.stderr)
        return EX_REJECTED
    return EX_OK if reply.get("ok", True) else EX_REJECTED


# ---------------------------------------------------------------- commands

def pick_instance(args):
    found = instances()
    if not found:
        print("fccli: no running FreeCAD with the command line loaded",
              file=sys.stderr)
        return None, EX_NOINSTANCE
    if args.pid:
        for pid, path in found:
            if pid == args.pid:
                return path, EX_OK
        print(f"fccli: no instance with pid {args.pid}", file=sys.stderr)
        return None, EX_NOINSTANCE
    if len(found) > 1:
        print("fccli: several instances, pass --pid:", file=sys.stderr)
        for pid, _ in found:
            print(f"  --pid {pid}", file=sys.stderr)
        return None, EX_AMBIGUOUS
    return found[0][1], EX_OK


def submit_lines(client, lines, args):
    worst = EX_OK
    deadline = time.monotonic() + (args.wait or 0)
    for line in lines:
        line = line.strip()
        if not line:
            continue
        while True:
            reply = client.ask(op="submit", text=line, steal=args.steal)
            if reply.get("kind") != "busy" or time.monotonic() >= deadline:
                break
            time.sleep(0.25)
        code = render(reply, args)
        worst = code if code and not worst else worst
    return worst


def cmd_exec(client, args):
    return submit_lines(client, args.command or _stdin_lines(), args)


def cmd_check(client, args):
    text = " ".join(args.command or [])
    return submit_lines(client, [f"check {text}"], args)


def cmd_history(client, args):
    reply = client.ask(op="history", limit=args.limit)
    entries = reply.get("entries", [])
    if args.json:
        print(json.dumps(entries))
        return EX_OK
    start = 1
    for i, line in enumerate(entries, start):
        print(f"{i:>5}  {line}")
    if args.follow:
        client.ask(op="subscribe")
        try:
            while True:
                msg = client.read()
                if msg.get("kind") == "result":
                    print(f"{'':>5}  {msg.get('replay') or msg.get('text')}")
                    sys.stdout.flush()
        except (KeyboardInterrupt, ConnectionError):
            pass
    return EX_OK


def find_freecad():
    for name in ("freecad", "FreeCAD"):
        found = shutil.which(name)
        if found:
            return found
    return None


def cmd_repl(client, args):
    """An interactive session against the running FreeCAD.

    Completions come from the server, so Tab offers what the dock would
    offer -- verb names, the open getter's options, the schema's unit on a
    bare number -- rather than a second implementation that drifts.
    """
    warn_protocol(client)
    try:
        import readline
    except ImportError:
        readline = None

    if readline is not None:
        _install_completer(client, readline, args)

    pid = client.hello.get("pid")
    print(f"attached to FreeCAD {pid}.")
    print(paint("  detach (or Ctrl+D) leaves this session running.  "
                "quit! shuts FreeCAD down.  Ctrl+C cancels a command.",
                "quiet", sys.stdout))
    state = client.hello

    while True:
        prompt = _prompt_for(state)
        try:
            line = input(prompt)
        except EOFError:
            print()
            return EX_OK
        except KeyboardInterrupt:
            print()
            state = client.ask(op="cancel") and client.ask(op="state")
            continue

        # Client-side words. detach is not a verb -- FreeCAD has nothing to
        # do about it. It ends this connection and leaves the session, its
        # documents and its undo stack exactly as they are.
        if line.strip() in ("detach", "\\d"):
            print(f"detached. FreeCAD {pid} is still running; "
                  "fccli attach to come back.")
            return EX_OK
        if line.strip() in ("exit", "\\q"):
            return EX_OK
        if not line.strip():
            state = client.ask(op="state")
            continue

        try:
            reply = client.ask(op="submit", text=line, steal=args.steal)
        except ConnectionError as exc:
            # quit! takes the session down under us, which is what was asked
            # for rather than a fault.
            if line.strip().startswith(("quit", "exit")):
                print("FreeCAD has shut down.")
                return EX_OK
            print(f"fccli: {exc}", file=sys.stderr)
            return EX_NOINSTANCE

        if reply.get("kind") == "busy":
            detail = reply.get("detail") or reply.get("holder") or reply["reason"]
            print(paint(f"not now: {detail}", "warn", sys.stdout))
            continue

        for msg in reply.get("messages", []):
            if not msg["text"] or msg["kind"] in ("live", "prompt"):
                continue
            role = msg.get("role", msg["kind"])
            prefix = {"error": "error: ", "result": "= "}.get(msg["kind"], "")
            print(paint(prefix + msg["text"], role, sys.stdout))
        state = reply


def _prompt_for(state):
    """The engine's own prompt, so the terminal shows what the dock shows."""
    if state.get("engine") == "idle" or not state.get("prompt"):
        return "> "
    options = state.get("options") or []
    tail = f" [{'/'.join(options)}]" if options else ""
    return f"{state['prompt']}{tail}: "


def _install_completer(client, readline, args):
    cache = {"text": None, "hits": []}

    def complete(text, index):
        buffer = readline.get_line_buffer()[:readline.get_endidx()]
        if cache["text"] != buffer:
            try:
                reply = client.ask(op="complete", text=buffer)
                cache["hits"] = reply.get("candidates", [])
            except (ConnectionError, ValueError):
                cache["hits"] = []
            cache["text"] = buffer
        try:
            return cache["hits"][index]
        except IndexError:
            return None

    readline.set_completer(complete)
    # Coordinates are one token: 0,0,0 must not split on the commas.
    readline.set_completer_delims(" \t\n")
    # The dock cycles through candidates on repeated Tab. readline's default
    # inserts the longest common prefix instead, which for "c" against
    # chamfer/check/circle/clear is "c" -- nothing happens, and the two
    # surfaces feel different for the same candidates.
    if "libedit" in getattr(readline, "__doc__", "") or "":
        readline.parse_and_bind("bind ^I rl_complete")
    else:
        readline.parse_and_bind("tab: menu-complete")
        readline.parse_and_bind('"\\e[Z": menu-complete-backward')
        readline.parse_and_bind("set show-all-if-ambiguous off")
        readline.parse_and_bind("set menu-complete-display-prefix off")
    try:
        history = client.ask(op="history", limit=500).get("entries", [])
        for line in history:
            readline.add_history(line)
    except (ConnectionError, ValueError):
        pass


def cmd_start(args):
    """Launch FreeCAD and wait until its command line is reachable.

    With -i, hand straight over to the interactive session, so one command
    goes from nothing running to a prompt.

    So a whole session can be run from a terminal: start it, drive it, quit
    it, without touching the application window.
    """
    binary = find_freecad()
    if binary is None:
        print("fccli: no freecad on PATH", file=sys.stderr)
        return EX_NOINSTANCE

    before = {pid for pid, _ in instances()}
    if before and not args.force:
        print(f"fccli: {len(before)} instance(s) already running. "
              "Use --force to start another, or fccli ls to see them.",
              file=sys.stderr)
        return EX_AMBIGUOUS

    runner = []
    if args.headless:
        if not shutil.which("xvfb-run"):
            print("fccli: --headless needs xvfb-run", file=sys.stderr)
            return EX_NOINSTANCE
        runner = ["xvfb-run", "-a", "-s", "-screen 0 1600x1000x24"]

    log = open(args.log, "ab") if args.log else subprocess.DEVNULL
    proc = subprocess.Popen(runner + [binary, *args.args],
                            stdout=log, stderr=log,
                            stdin=subprocess.DEVNULL, start_new_session=True)
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        fresh = [(pid, path) for pid, path in instances() if pid not in before]
        if fresh:
            pid, path = fresh[0]
            if args.json:
                print(json.dumps({"pid": pid, "socket": path,
                                  "only": not before}))
                return EX_OK
            print(f"started FreeCAD, pid {pid}")
            if args.interactive:
                try:
                    return cmd_repl(Client(path), args)
                except (OSError, ConnectionError) as exc:
                    print(f"fccli: {exc}", file=sys.stderr)
                    return EX_NOINSTANCE
            if not before:
                print("commands attach to it with no --pid.")
            return EX_OK
        if proc.poll() is not None:
            print(f"fccli: FreeCAD exited before opening a socket "
                  f"(status {proc.returncode})", file=sys.stderr)
            return EX_NOINSTANCE
        time.sleep(0.5)
    print(f"fccli: no socket after {args.timeout:g}s. Is the addon installed?",
          file=sys.stderr)
    return EX_NOINSTANCE


def cmd_docs(client, args):
    warn_protocol(client)
    reply = client.ask(op="documents")
    if reply.get("kind") == "error":
        reply = client.ask(op="state")          # older servers had no op
    docs = documents_of(reply)
    if args.json:
        print(json.dumps(docs))
        return EX_OK
    if not docs:
        print("no documents open")
        return EX_OK
    for doc in docs:
        show_document(doc, indent="")
    return EX_OK


def cmd_state(client, args):
    warn_protocol(client)
    reply = client.ask(op="state")
    if args.json:
        print(json.dumps(reply))
        return EX_OK
    print(f"pid       {client.hello.get('pid')}")
    print(f"clients   {reply.get('clients')}")
    print(f"engine    {reply.get('engine')}")
    if reply.get("verb"):
        print(f"command   {reply['verb']} -- wants {reply.get('prompt')}")
    floor = reply.get("floor") or {}
    print(f"floor     {floor.get('holder') or 'free'}"
          f"{' (busy)' if floor.get('busy') else ''}")
    for doc in documents_of(reply):
        show_document(doc)
    return EX_OK


def _stdin_lines(wait=0.1):
    """Lines piped in, or nothing.

    A pipe that is open but idle would block a bare `fccli` forever, so the
    no-subcommand path asks whether anything is actually waiting rather than
    reading and hoping.
    """
    if sys.stdin.isatty():
        return []
    if wait is not None:
        try:
            ready, _, _ = select.select([sys.stdin], [], [], wait)
            if not ready:
                return []
        except (OSError, ValueError):
            return []
    return sys.stdin.read().splitlines()


EPILOG = """\
Attaching:
  With one FreeCAD running, every command attaches to it. --pid is only
  needed when several are running; fccli ls names them.

  fccli start -i        from nothing running to a prompt, in one command
  fccli attach          attach to one that is already running
  detach                inside the session: leave, and let it keep running
  quit!                 inside the session: shut FreeCAD down

Exit codes:
  0   done
  1   the command was rejected -- a fault, reason on stderr
  2   usage
  3   no running instance, or it went away
  4   several instances, pass --pid
  75  busy -- a dialog is open or someone holds the floor. Ordinary, not a
      fault: EX_TEMPFAIL, so `if ! fccli exec ...` does not read it as a
      broken command. --wait queues instead.
"""


def show_help(parser):
    """Bare fccli: the help, and what there is to attach to."""
    parser.print_help()
    found = instances()
    print()
    if not found:
        print("No FreeCAD is running with the command line loaded.")
        return EX_OK
    if len(found) == 1:
        pid, _ = found[0]
        print(f"One instance running (pid {pid}); commands attach to it "
              "with no --pid.")
    else:
        print(f"{len(found)} instances running -- pass --pid:")
        for pid, _ in found:
            print(f"  --pid {pid}")
    print("Try: fccli ls")
    return EX_OK


def main():
    parser = argparse.ArgumentParser(
        prog="fccli", description=__doc__.split("\n\n")[0],
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--pid", type=int, help="which FreeCAD to talk to")
    parser.add_argument("--json", action="store_true",
                        help="raw messages, for programs")
    parser.add_argument("--wait", type=float, default=0, metavar="SECONDS",
                        help="queue for the floor instead of giving up")
    parser.add_argument("--steal", action="store_true",
                        help="take the floor from whoever holds it")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="show the running echo and prompts too")
    sub = parser.add_subparsers(dest="op")

    run = sub.add_parser("exec", help="run a command")
    run.add_argument("command", nargs="*")

    chk = sub.add_parser("check", help="validate without running")
    chk.add_argument("command", nargs="+")

    hist = sub.add_parser("history", help="what has been run")
    hist.add_argument("-n", "--limit", type=int, default=50)
    hist.add_argument("-f", "--follow", action="store_true")

    sub.add_parser("state", help="what the session is doing")

    start = sub.add_parser("start", help="launch FreeCAD and wait for it")
    start.add_argument("args", nargs="*", help="passed through to FreeCAD")
    start.add_argument("--headless", action="store_true",
                       help="run under a virtual display (needs xvfb-run)")
    start.add_argument("--timeout", type=float, default=90, metavar="SECONDS")
    start.add_argument("--log", metavar="FILE", help="where FreeCAD's own output goes")
    start.add_argument("--force", action="store_true",
                       help="start another even if one is running")
    start.add_argument("-i", "--interactive", "--attach", action="store_true",
                       dest="interactive",
                       help="attach to it as soon as it is up")

    sub.add_parser("attach", help="an interactive session (aliases: repl, i)")
    sub.add_parser("repl", help=argparse.SUPPRESS)
    sub.add_parser("i", help=argparse.SUPPRESS)
    sub.add_parser("ls", help="running instances and what they have open")
    sub.add_parser("docs", help="documents open in one instance")

    args = parser.parse_args()

    # No subcommand and nothing piped in: the caller is looking around.
    # Show what this does and what it can reach, rather than a terse error.
    if args.op is None:
        piped = _stdin_lines()
        if not any(line.strip() for line in piped):
            return show_help(parser)
        args.command = piped

    if args.op == "start":
        return cmd_start(args)

    if args.op == "ls":
        found = instances()
        if not found:
            print("no running FreeCAD with the command line loaded")
            return EX_NOINSTANCE
        rows = []
        for pid, path in found:
            row = {"pid": pid, "socket": path, "reachable": False}
            try:
                client = Client(path)
                row.update(client.ask(op="state"))
                row["reachable"] = True
                client.close()
            except (OSError, ConnectionError, ValueError) as exc:
                row["error"] = str(exc)
            rows.append(row)
        if args.json:
            print(json.dumps(rows, default=str))
            return EX_OK
        for row in rows:
            if not row["reachable"]:
                print(f"pid {row['pid']}  unreachable: "
                      f"{row.get('error', '')[:60]}")
                continue
            floor = (row.get("floor") or {}).get("holder") or "free"
            doing = row.get("verb") or row.get("engine", "?")
            print(f"pid {row['pid']}   {doing}, "
                  f"{row.get('clients', 0)} client(s), floor {floor}")
            docs = documents_of(row)
            if not docs:
                print("    (no documents open)")
            for doc in docs:
                show_document(doc)
        return EX_OK

    path, code = pick_instance(args)
    if path is None:
        return code

    try:
        client = Client(path)
    except (OSError, ConnectionError) as exc:
        print(f"fccli: cannot reach the session: {exc}", file=sys.stderr)
        return EX_NOINSTANCE

    try:
        handler = {"exec": cmd_exec, "check": cmd_check, "docs": cmd_docs,
                   "history": cmd_history, "state": cmd_state,
                   "attach": cmd_repl, "repl": cmd_repl,
                   "i": cmd_repl}.get(args.op)
        if handler is None:
            handler = cmd_exec          # stdin was a script
        return handler(client, args)
    except ConnectionError as exc:
        print(f"fccli: {exc}", file=sys.stderr)
        return EX_NOINSTANCE
    finally:
        client.close()


if __name__ == "__main__":
    sys.exit(main())
